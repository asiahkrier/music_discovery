PORT=3006
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never use a VITE_ prefix for this key. Required for account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Spotify account linking (server only; never prefix these with VITE_).
# Register this exact callback URL in the Spotify developer dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5184/api/spotify/callback
# Generate once with: openssl rand -base64 32. Keep stable; changing it invalidates stored connections.
SPOTIFY_TOKEN_ENCRYPTION_KEY=
