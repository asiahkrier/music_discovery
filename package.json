{
  "name": "music_discovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"node server/index.js\" \"vite --config client/vite.config.js\"",
